# Copy this file to `.env` and replace the placeholder values.

DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_EMAIL_HOST_USER=replace-me
DJANGO_EMAIL_HOST_PASSWORD=replace-me
DJANGO_RECAPTCHA_PUBLIC_KEY=replace-me
DJANGO_RECAPTCHA_PRIVATE_KEY=replace-me

# Optional: only needed for AI alt-text generation on gallery uploads.
OPENAI_API_KEY=
